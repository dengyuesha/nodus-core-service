# 复制为 /opt/nodus-core-service/nodus-core.env，并限制为 600 权限。
NODUS_CORE_PORT=8094
NODUS_CORE_DB_URL=jdbc:postgresql://127.0.0.1:5432/nodus_core
NODUS_CORE_DB_USER=nodus_core
NODUS_CORE_DB_PASSWORD=change-me
NODUS_CORE_API_KEY=change-to-a-long-random-value
NODUS_CORE_IDEMPOTENCY_TTL=24h
NODUS_CORE_REMINDER_SCAN_INTERVAL=1s
NODUS_CORE_DELIVERY_RETRY_DELAY=15s
NODUS_CORE_DELIVERY_LEASE=30s
NODUS_CORE_INSIGHT_AINAS_ENABLED=false
NODUS_CORE_INSIGHT_AINAS_BASE_URL=http://127.0.0.1:8083
NODUS_CORE_INSIGHT_AINAS_API_KEY=replace-with-ainas-gateway-key
NODUS_CORE_INSIGHT_AINAS_TIMEOUT=90s
NODUS_MEDIA_STAGING_DIR=/home/aidlux/Videos/NodusMedia/staging
NODUS_MEDIA_MOVIES_DIR=/home/aidlux/Videos/NodusMedia/Movies
NODUS_MEDIA_SHOWS_DIR=/home/aidlux/Videos/NodusMedia/TV
NODUS_MEDIA_MIN_FREE_BYTES=10737418240
NODUS_MEDIA_MAX_LIBRARY_BYTES=10737418240
NODUS_MEDIA_MAX_FILE_BYTES=8589934592
NODUS_MEDIA_FFPROBE_PATH=/usr/bin/ffprobe
NODUS_JELLYFIN_BASE_URL=http://127.0.0.1:8096
NODUS_JELLYFIN_API_KEY=
